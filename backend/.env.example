# ==========================================
# CONFIGURACION DEL SERVIDOR
# ==========================================
PORT=3001
NODE_ENV=development

# ==========================================
# ORGANIZACION - nombre del cliente que usa el sistema.
# Encabeza los PDF/Word generados y el sidebar.
# ==========================================
ORG_NOMBRE=Mi organizacion

# ==========================================
# CORS - URL del frontend autorizado
# ==========================================
CORS_ORIGIN=http://localhost:5173

# ==========================================
# JWT - Para sesiones (lo usaremos en Fase 1)
# ==========================================
JWT_SECRET=cambiar-este-valor-por-uno-aleatorio-y-largo
JWT_EXPIRATION=12h

# ==========================================
# SUPABASE - Conexion al proyecto cloud
# ==========================================
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxx

# ==========================================
# CLOUDINARY - Almacenamiento de imagenes
# ==========================================
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# ==========================================
# CORREO - Avisos importantes por email (Gmail + contrasena de aplicacion)
# Si se dejan vacias, el envio de correo se OMITE (la app sigue funcionando).
# GMAIL_USER: el correo desde el que se envia (ej. avisos.sisvia@gmail.com)
# GMAIL_APP_PASSWORD: "contrasena de aplicacion" de 16 letras (NO la clave normal).
#   Se crea en: Cuenta de Google > Seguridad > Verificacion en 2 pasos > Contrasenas de aplicaciones
# ==========================================
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Hora del aviso diario de vencimientos (cron). Por defecto 7:00 am.
CRON_VENCIMIENTOS=0 7 * * *